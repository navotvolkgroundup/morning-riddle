# Modelled on m5stack/M5PaperColor-UserDemo's sdkconfig.defaults. The values
# that are NOT free choices are marked; getting them wrong does not fail the
# build, it produces a board that dies between the ROM banner and the
# second-stage bootloader with no diagnostic at all. (Observed: flashing the
# Waveshare build, which configures QUAD psram, onto this board.)

# ===== Partition Table =====
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ===== Serial Flasher =====
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ===== PSRAM -- HARDWARE, NOT PREFERENCE =====
# Octal at 40MHz on IO30/IO26. The Waveshare board is quad; this one is not.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ===== Console -- HARDWARE =====
# UART on IO5/IO4, mirrored to USB Serial/JTAG so a cabled board logs.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=5
CONFIG_ESP_CONSOLE_UART_RX_GPIO=4
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ===== System =====
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# ===== Wi-Fi + TLS =====
# The riddle batch is an HTTPS GET from a GitHub release, which redirects to a
# signed objects.githubusercontent.com URL. See the fetch code for why the
# HTTP client's buffers are enlarged.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# ===== FAT, for the microSD card =====
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_437=y

CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
