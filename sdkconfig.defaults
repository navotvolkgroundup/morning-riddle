# Taken VERBATIM from m5stack/M5PaperColor-UserDemo, minus its app-only
# options. Reason: a hand-written adaptation of this file built and flashed
# perfectly and never once executed, on a board that runs the reference
# firmware. When a reference config works and yours does not, the difference is
# the bug, and the cheapest fix is to stop differing.
#
# The console stays on the physical UART as the reference has it, even though
# nothing is wired to IO5/IO4 and we therefore get no serial. Getting the board
# RUNNING comes first; the console can move once something executes.

# ===== Partition Table =====
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ===== Serial Flasher =====
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_BEFORE="default_reset"
CONFIG_ESPTOOLPY_AFTER="hard_reset"

# ===== Compiler =====
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# ===== ESP System Settings =====
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y

# ===== Console: USB Serial/JTAG =====
# The reference puts this on the physical UART at IO5/IO4. Nothing is wired to
# those pins here, so everything is diagnosed over the USB cable instead.
#
# This is the ONLY intentional deviation from the reference config, changed on
# its own after the board was confirmed booting -- so if a future board stops
# starting, this is the first line to suspect and the easiest to revert.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ===== PSRAM (Octal, 40MHz) =====
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ===== Brownout Detector =====
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y

# ===== Wi-Fi =====
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# ===== FAT Filesystem =====
CONFIG_FATFS_VOLUME_COUNT=2
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_SECTOR_4096=y
CONFIG_FATFS_CODEPAGE_437=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_PER_FILE_CACHE=y
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y

# ===== Wear Levelling =====
CONFIG_WL_SECTOR_SIZE_4096=y

# ===== Core Dump =====
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
